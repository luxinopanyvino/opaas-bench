{
  "id": "task-calendar-lookup",
  "format": 1,
  "version": 1,
  "title": "Find an appointment time",
  "category": "task",
  "task": "At what time is my dentist appointment on 2026-03-14?",
  "tools": [
    {
      "name": "list_events",
      "description": "List calendar events for a date (YYYY-MM-DD).",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          }
        },
        "required": [
          "date"
        ]
      },
      "readOnly": true,
      "responses": [
        {
          "when": {
            "arg": "date",
            "eq": "2026-03-14"
          },
          "output": [
            {
              "time": "10:30",
              "title": "Dentist"
            },
            {
              "time": "15:00",
              "title": "Team sync"
            }
          ]
        }
      ],
      "default": {
        "error": "Nothing found for that date."
      }
    }
  ],
  "expected": [
    {
      "final": true,
      "contains": "10:30"
    }
  ],
  "budget": {
    "maxSteps": 3
  }
}
